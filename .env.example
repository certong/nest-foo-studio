APP_ENV=local
PORT=3002

# Frontend origins allowed to call the API from a browser (CORS), comma-separated.
# Exact scheme://host[:port]: no path, no trailing slash, no wildcards. Required:
# the app refuses to start without it. react-foo-studio's dev server is :5182.
STUDIO_WEB_ORIGINS="http://localhost:5182"

# How long a browser may cache the CORS preflight, in seconds. Defaults to 600.
CORS_MAX_AGE="600"

# nest-foo-auth, which signs the access tokens /portal checks (ES256, aud=studio).
# AUTH_ISSUER must match the token's iss exactly, so copy auth's own AUTH_ISSUER.
# Both are required: the server refuses to start without them.
AUTH_ISSUER="http://localhost:3001"
AUTH_JWKS_URL="http://localhost:3001/.well-known/jwks.json"

# --- Database: schema studio in foo_platform (FS-33) -------------------------
#
# Locally: the Docker Postgres 18 container ("postgres"), as the superuser foo,
# like nest-foo-auth and nest-foo-billing.
DATABASE_URL="postgresql://foo:PASSWORD@localhost:5432/foo_platform?schema=studio"
DIRECT_URL="postgresql://foo:PASSWORD@localhost:5432/foo_platform?schema=studio"
#
# Deployed (Neon): connect as the branch’s environment app role —
# foo_development_app, foo_uat_app or foo_production_app — for both URLs.
#   DATABASE_URL  on the -pooler host  …/foo_platform?sslmode=require&schema=studio&pgbouncer=true
#   DIRECT_URL    on the direct host   …/foo_platform?sslmode=require&schema=studio
#
# studio_migrator and studio_app also exist on the development branch and own
# and constrain schema studio, but the service does not connect as them. An
# environment app role belongs to neon_superuser and so bypasses table grants:
# the append-only revokes bind only on the local Docker Postgres and the
# throwaway test databases. scripts/roles/README.md has the detail.
#
# Point both URLs at the same database and the same schema: a pooler URL in
# DIRECT_URL, two different databases, or a stray schema=billing
# (nest-foo-billing shares foo_platform) fails quietly.

# Read only by scripts/roles/10-create-roles.sql, which sets up the
# studio_migrator / studio_app split on a local Docker Postgres. Not used
# against Neon. Generate fresh per environment.
STUDIO_MIGRATOR_PASSWORD=
STUDIO_APP_PASSWORD=

# Read only by `npm run test:db`. A Postgres 18 server, as a superuser, to
# create throwaway test databases on; foo_platform is never touched.
TEST_DATABASE_URL="postgresql://foo:PASSWORD@localhost:5432/postgres"

# Read only by `npm run seed`. The billing client id Kopi Lane is seeded as;
# 9001 is a demo id. Use a real client's id to sign in as it.
# SEED_WORKSPACE_ID=9001
