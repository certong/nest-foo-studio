{
  "name": "nest-foo-studio",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi": "ts-node -P tsconfig.json scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/swagger": "11.4.7",
    "nestjs-zod": "5.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.3",
    "@swc/core": "1.16.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/supertest": "7.2.1",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.11",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "@swc/core@1.16.1": true,
    "@scarf/scarf@1.4.0": false
  }
}
